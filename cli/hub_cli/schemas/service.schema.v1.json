{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "N100 Service Hub service definition (schema_version 1)",
  "type": "object",
  "required": ["schema_version", "service", "deployment"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "service": {
      "type": "object",
      "required": ["id", "name", "description", "category"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
          "description": "영문 소문자/숫자/하이픈. 중복 불가."
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "category": {
          "type": "string",
          "enum": ["web", "backend", "database", "ai", "automation", "media", "dev", "infra", "other"]
        },
        "version": { "type": "string" },
        "documentation": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_url": { "type": "string" },
        "branch": { "type": "string" }
      }
    },
    "deployment": {
      "type": "object",
      "required": ["type", "compose_file"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["docker-compose"] },
        "compose_file": { "type": "string", "minLength": 1 },
        "project_name": { "type": "string" }
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "exposure", "container", "container_port"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["http", "https", "tcp", "udp", "grpc"] },
          "exposure": { "type": "string", "enum": ["proxy", "host", "internal"] },
          "hostname": { "type": "string", "description": "exposure=proxy일 때 필요" },
          "host_port": {
            "type": "integer",
            "minimum": 50000,
            "maximum": 59999,
            "description": "exposure=host일 때 필수. 공유기가 N100으로 포워딩하는 50000-59999 대역의 미할당 포트만 허용"
          },
          "container": { "type": "string", "minLength": 1 },
          "container_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "auth": {
            "type": "object",
            "description": "인증 요구 사항. 시크릿 값이 아니라 '어디서 얻는지' 참조만 기록한다.",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["none", "basic", "bearer", "api_key", "mtls", "custom"],
                "default": "none"
              },
              "credentials_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "^[a-z0-9][a-z0-9+.-]*://\\S+$",
                "description": "자격 증명 위치. 예: 1password://n100/gyeol/basic, operator://ask-admin"
              },
              "hint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "사람이 읽는 안내. 비밀번호/토큰 값 금지."
              },
              "header": {
                "type": "string",
                "maxLength": 120,
                "pattern": "^[A-Za-z0-9-]+$",
                "description": "bearer/api_key/custom 인증 헤더 이름. 예: X-User-Id"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": { "enum": ["basic", "bearer", "api_key", "mtls", "custom"] }
                  },
                  "required": ["type"]
                },
                "then": { "required": ["credentials_ref"] }
              },
              {
                "if": {
                  "properties": { "type": { "const": "none" } },
                  "required": ["type"]
                },
                "then": {
                  "allOf": [
                    { "not": { "required": ["credentials_ref"] } },
                    { "not": { "required": ["hint"] } },
                    { "not": { "required": ["header"] } }
                  ]
                }
              }
            ]
          },
          "api_base_path": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^/",
            "description": "API 기본 경로. 예: /api/v1"
          },
          "health_path": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^/",
            "description": "헬스체크 경로. 예: /healthz"
          },
          "docs_url": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https?://\\S+$",
            "description": "문서/OpenAPI URL"
          },
          "bind_addr": {
            "type": "string",
            "maxLength": 64,
            "description": "호스트 바인드 주소(정보용). 예: 100.85.245.79, 0.0.0.0"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "exposure": { "const": "proxy" } } },
            "then": { "required": ["hostname"] }
          },
          {
            "if": { "properties": { "exposure": { "const": "host" } } },
            "then": { "required": ["host_port"] }
          }
        ]
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["frontend", "backend", "worker", "database", "cache", "proxy", "other"] },
          "required": { "type": "boolean", "default": true },
          "description": { "type": "string" }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_limit_mb": { "type": "integer", "minimum": 16 },
        "cpu_limit": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "purpose"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "purpose": { "type": "string" },
          "backup_required": { "type": "boolean", "default": false }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "healthcheck_required": { "type": "boolean", "default": true },
        "backup_required": { "type": "boolean", "default": false },
        "restart_policy": { "type": "string", "enum": ["no", "always", "unless-stopped", "on-failure"] }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "description": "시크릿 값 금지. 참조/정책만 허용.",
      "properties": {
        "expose_database": { "type": "boolean", "default": false },
        "required_env": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "description": ".env.example에 있어야 하는 환경 변수 이름 목록 (값 금지)"
        }
      }
    }
  }
}
