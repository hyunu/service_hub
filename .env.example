# N100 Service Hub 환경 변수 (설치 시 복사 후 수정)
# 이 파일에 실제 비밀번호/토큰을 커밋하지 마세요.

# 관리 이름
HUB_NAME=N100 Service Hub

# 관리 포트 및 바인드 주소 (기본 루프백. 내부망 공개 시 서버 IP로 변경하고 방화벽 적용)
HUB_BIND=127.0.0.1
HUB_PORT=8420

# 데이터베이스/캐시 경로 (컨테이너 배포 시 볼륨 마운트 대상)
HUB_DB_PATH=/data/hub.db
HUB_STATUS_CACHE=/data/status.json

# 백그라운드 모니터링 주기(초)
HUB_MONITOR_INTERVAL=15

# 배포 기능 잠금 — true로 바꾸기 전에 docs/SECURITY.md를 확인하세요
HUB_ENABLE_DEPLOY=false

# MCP/AI 가 로컬 소스를 /srv/services/<id> 로 업로드 (파괴적) — 기본 잠금
HUB_ENABLE_SOURCE_UPLOAD=false
HUB_SOURCE_UPLOAD_MAX_MB=200

# Docker 소켓 (백엔드만 마운트. 프런트엔드에 마운트하지 마세요)
HUB_DOCKER_SOCKET=/var/run/docker.sock

# 호스트 docker 그룹 GID — 컨테이너 비루트 사용자가 소켓에 접근하기 위해 필요.
# 서버에서 `getent group docker`로 확인한다 (설치 스크립트가 자동으로 채운다).
HUB_DOCKER_GID=988

# 배포 대상 서비스 디렉터리 (hub가 배포 작업을 허용하는 범위)
HUB_SERVICES_DIR=/srv/services

# 컨테이너 내부에서의 배포 작업 디렉터리 (컨테이너 경로)
HUB_DEPLOY_WORKDIR=/srv/services

# 자원 경고 임계값 (%)
HUB_MEM_WARN_PCT=80
HUB_MEM_CRIT_PCT=90
HUB_DISK_WARN_PCT=80
HUB_DISK_CRIT_PCT=90
HUB_CPU_WARN_PCT=80
HUB_CPU_CRIT_PCT=95
HUB_CPU_SUSTAIN_SECONDS=60

# 세션 서명 키 — 최초 설치 시 자동 생성되므로 비워 두는 것을 권장합니다.
# HUB_SECRET_KEY=

# 관리자 비밀번호 분실 복구 토큰 (hub admin reset).
# 비어 있으면 루프백 실행에서만 초기화할 수 있습니다.
# 값을 넣으면 X-Hub-Admin-Reset-Token 헤더로 원격 초기화가 가능하지만 1회 사용 후 폐기됩니다.
# 사용이 끝나면 이 줄을 삭제하고 백엔드를 재기동하세요.
# HUB_ADMIN_RESET_TOKEN=
